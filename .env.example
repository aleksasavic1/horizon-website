# Environment variables for Horizon project

# ⚠️ IMPORTANT: You must create a `.env.local` file in the root directory
# and copy these variables there, replacing `your_value_here` with actual values.
# This file is NOT used directly by the app. It only serves as a template.

VITE_API_BASE_URL=https://api.rawg.io/api
VITE_RAWG_API_KEY=your_rawg_api_key_here
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_PROJECT_ID=your_firebase_project_id
VITE_AUTH_DOMAIN=your_auth_domain
VITE_STORAGE_BUCKET=your_storage_bucket
VITE_APP_ID=your_firebase_app_id

# 🚀 How to set up:
# 1. Copy `.env.example` to `.env.local`
#    Run this command in the terminal:
#    cp .env.example .env.local
#
# 2. Open `.env.local` and replace `your_value_here` with actual values.
#
# 3. Start the app:
#    npm run dev
#
# If you don't set the API keys, the app will not work properly.